{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/depgraph/catalog-info.schema.json",
  "title": "catalog-info.yaml",
  "description": "Backstage catalog entity read by depgraph. dependsOn resolution is enforced by depgraph validate-catalog, not by this schema alone.",
  "type": "object",
  "additionalProperties": true,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "backstage.io/v1alpha1" },
    "kind": { "enum": ["Component", "Resource"] },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Canonical component or resource name."
        },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "properties": {
            "gitlab.com/project-slug": { "type": "string" },
            "depgraph/otel-service-name": { "type": "string" },
            "depgraph/k8s-app-name": { "type": "string" },
            "depgraph/image-repository": { "type": "string" },
            "depgraph/soft-dependencies": { "type": "string" },
            "depgraph/gitlab-environments": { "type": "string" }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["experimental", "production", "deprecated"] },
        "owner": { "type": "string", "minLength": 1 },
        "system": { "type": "string" },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(component|resource):default/[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "Component" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "spec": {
            "required": ["type", "lifecycle", "owner"],
            "properties": {
              "type": { "enum": ["service", "job", "library", "website"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "Resource" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "spec": {
            "required": ["type", "owner"]
          }
        }
      }
    }
  ]
}
